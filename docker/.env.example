# Tribu Environment Variables
# Copy to .env and fill in values:  cp .env.example .env

# ── Required ──────────────────────────────────────────────────

# Generate with: openssl rand -hex 32
JWT_SECRET=

# Database password for PostgreSQL
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=

# ── Optional ──────────────────────────────────────────────────

# Secure flag on auth cookies (sent over HTTPS only). The default "auto" sets it
# whenever the browser reaches Tribu over HTTPS, also behind a TLS reverse proxy
# (nginx, Caddy, Traefik) that sends X-Forwarded-Proto. true always sets it,
# false never does.
# SECURE_COOKIES=auto

# Public URL of your instance (e.g. https://tribu.example.com)
# Auto-detected from request headers if not set
# BASE_URL=

# Short-lived access cookie lifetime, in hours (default: 24)
# The web app can refresh active sessions with a revocable httpOnly refresh cookie.
# JWT_EXPIRE_HOURS=24

# Refresh session lifetime, in days (default: 30)
# Keep JWT_SECRET stable in your persisted .env to preserve sessions across container updates.
# REFRESH_TOKEN_EXPIRE_DAYS=30

# IANA timezone used for family calendar/task times, quiet hours, and reminders.
# Audit/session timestamps stay in UTC. Leave unset for UTC fallback.
# Examples: Europe/Berlin, America/New_York.
# TZ=Europe/Berlin

# Extra exact browser origins for direct backend access. Default only allows localhost.
# Listed origins may also use the session cookie; other sites cannot.
# CORS_ALLOWED_ORIGINS=https://tribu.example.com

# Set true only if you deliberately expose the backend to 192.168.x.x browser origins.
# CORS_ALLOW_LAN_ORIGINS=false

# Comma-separated trusted reverse proxy CIDRs for X-Forwarded-For rate-limit keys.
# TRUSTED_PROXY_CIDRS=172.16.0.0/12

# Set true only if ICS subscriptions must fetch LAN/private calendar feeds.
# SUBSCRIPTIONS_ALLOW_PRIVATE_NETWORKS=false

# Limits for calendar feeds: download size in bytes, and events per feed sync or ICS import.
# ICS_FEED_MAX_BYTES=1048576
# ICS_MAX_EVENTS=500

# ── Push Notifications (optional) ────────────────────────────
# Generate keys with: npx web-push generate-vapid-keys

# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CLAIMS_EMAIL=admin@example.com
